# ============================================================
# 寻径教育系统 PathFinder · 环境变量样例
# ------------------------------------------------------------
# 复制为 .env 并填写即可从「规则模拟」切到「真实模型」。
# 不建 .env（或保持 LLM_MODE=mock）时，全链路走规则版，断网也能完整演示。
#
# 纪律：这是全项目唯一读环境变量的文件对应的配置，代码里只有 config.py
# 会 os.getenv，其它模块一律 import config 取属性 —— 所以切模型只改这里。
# 每一项都给了与 config.py 一致的默认值，不写就是默认值。
# ============================================================

# ------------------------------------------------------------ 模型网关
# mock = 规则模拟（默认，无需网络） | api = 调用真实模型
LLM_MODE=mock

# OpenAI 兼容协议的服务地址（填到 /v1 为止，不要带 /chat/completions）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 视觉模型：必须支持 image_url 输入。图片作业的 AI 建议分、图片素材解析会用到；
# 不填则回落到 LLM_MODEL；配不出视觉能力时，相关能力会明确提示「需人工处理」。
LLM_VISION_MODEL=gpt-4o-mini
# 向量模型：不配则退化为本地字符 3-gram 哈希向量（1024 维，效果弱但断网可用）
EMBED_MODEL=text-embedding-3-small

# 单次请求超时（秒）与重试（总尝试次数含首次；每次之间的等待秒数）
LLM_TIMEOUT=60
LLM_RETRY=2
LLM_RETRY_WAIT=1.0

# ------------------------------------------------------------ 业务阈值
# 单个上传文件的体积上限（MB）
MAX_UPLOAD_MB=8
# 登录会话有效期（天）
SESSION_DAYS=7

# ------------------------------------------------------------ 检索调参
# 入库切片长度与重叠（普通材料）
CHUNK_SIZE=400
CHUNK_OVERLAP=80
# 上传解析时的切片长度与重叠（比入库切片大，保留上下文）
PARSE_CHUNK_SIZE=800
PARSE_CHUNK_OVERLAP=200
# RRF 融合的平滑常数
RRF_K=60

# ------------------------------------------------------------ 服务与数据目录
# 0.0.0.0 才能被局域网 / 内网穿透 / 云服务器访问；仅本机独享用 127.0.0.1
HOST=127.0.0.1
PORT=8000
# 下面两项一般不用动；冒烟测试（backend/smoke.py）靠它们把数据指向临时目录，
# 从而绝不污染开发库。留空则用 data/ 与 data/pathfinder.db。
DATA_DIR=
DB_PATH=
